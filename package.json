{
  "name": "tri-link",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub + Gitee + AFDian three-way linkage framework",
  "workspaces": [
    "packages/*",
    "agent"
  ],
  "scripts": {
    "dev:dashboard": "cd packages/dashboard && node server.js",
    "dev:mcp": "cd packages/afdian-mcp && npm run dev",
    "test:mcp": "cd packages/afdian-mcp && node test/index.js",
    "build": "npm run build --workspaces",
    "lint": "echo 'No linter configured'",
    "agent": "node bin/agent-cli.js",
    "agent:status": "node bin/agent-cli.js --status",
    "agent:auto-sync": "node bin/agent-cli.js --auto-sync",
    "agent:check": "node bin/agent-cli.js --check",
    "agent:plan": "node bin/agent-cli.js --plan",
    "publish:all": "node scripts/publish.js",
    "publish:mcp": "npm publish --workspace packages/afdian-mcp --workspace packages/github-api-v2",
    "publish:dashboard": "npm publish --workspace packages/dashboard",
    "test": "node agent/test/integration.js",
    "maintain": "node bin/auto-maintain.js",
    "maintain:start": "node bin/auto-maintain.js start 10",
    "maintain:stop": "node bin/auto-maintain.js stop",
    "maintain:status": "node bin/auto-maintain.js status",
    "maintain:sync": "node bin/auto-maintain.js sync",
    "maintain:report": "node bin/auto-maintain.js report",
    "maintain:diff": "node bin/auto-maintain.js diff"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}